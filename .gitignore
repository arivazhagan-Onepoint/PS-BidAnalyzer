# Credentials & tokens — never commit (ignore the whole folder)
credentials/

# Generated data output
extract_json/
target_json/
adapters/**/extract_json/
adapters/**/target_json/

# Generated decision heuristics — rebuilt each run by analyzer.maintain_knowledge
analyzer/knowledge/nobid_patterns.md
analyzer/knowledge/bid_patterns.md

# Ingested source corpus — rebuilt by DetailedAnalyzer.sources from Drive and
# from onepointltd.com.
# Never commit: unreleased commercial evidence (client names, contract detail,
# compliance answers) even after PII stripping.
DetailedAnalyzer/knowledge/onepoint_corpus.md


# Extracted tender packs, cached per OCID by DetailedAnalyzer.tender_docs.
# Never commit: these are the buyers' own documents, routinely covered by the
# confidentiality terms of the ITT they came from.
DetailedAnalyzer/knowledge/tender_docs/

# Logs
*.log

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]

# Claude Code local settings
.claude/settings.local.json

#Project specific configuration files to be exluded
project_config*.json
project_config.json

# Prompt dumps written by dump_prompts.py — regenerate them with that script
# rather than tracking them. The .full.txt expansions must never be committed:
# they inline the corpus and heuristics ignored above. The skeleton views are
# safe in themselves, but carry a generation timestamp that churns every run.
prompts/*.txt
